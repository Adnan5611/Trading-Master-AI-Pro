{
  "name": "trading-master-ai-pro",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based trading analysis platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p packages/trading-core/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit",
    "verify": "npm run typecheck && npm test && npm run build && npm audit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
