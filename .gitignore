# ---------------------------------------------------------------
# Trading Master AI Pro — .gitignore
# Never commit secrets, API keys, local databases, or build output.
# ---------------------------------------------------------------

# Environment / secrets (NEVER commit)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
service-account*.json

# Node / TypeScript
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Build output
dist/
build/
out/
.output/
.next/
.nuxt/
.svelte-kit/
.vite/
.turbo/
.parcel-cache/
coverage/
*.lcov

# Test / tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.tox/
__pycache__/
*.py[cod]
.cache/

# Electron / React Native / Android artifacts
release/
*.asar
apps/mobile/android/.gradle/
apps/mobile/android/app/build/
apps/mobile/ios/Pods/
*.apk
*.aab
*.ipa
*.hprof
.expo/
.expo-shared/

# Local databases & runtime data (market data is external)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
data/
tmp/
temp/
logs/
*.log

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Agent / tooling scratch (not project source)
.arena/
.claude/
.cursor/
